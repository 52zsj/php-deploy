# 构建上下文：只打框架，排除机密与业务配置
.git
.idea
.cursor
.cunzhi-memory
.credentials
.secrets
.DS_Store
**/__pycache__
**/*.pyc
**/*.pyo
.venv-desktop/
.venv/
.uploads/
yml/

# 运行产物 / 本机数据（仅放行 demo 模板进镜像）
logs/**
!logs/.gitignore
replace/**
!replace/.gitignore
data/**
!data/configs/
!data/configs/demo.yml
!data/configs/demo-dir.yml
deploy/data/
dist/

*.env
*.git-credentials

# 打包器源码与体积大的中间物不必进镜像
script/pack/launcher/payload.tar.gz
script/pack/launcher/*.exe
*.md
!NOTICE
TEST_GUIDE.md
USAGE.md
README.md
